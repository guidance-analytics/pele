{
  "name": "pele",
  "version": "1.13.0",
  "description": "A fast, lightweight Mermaid renderer that outputs themeable SVG.",
  "license": "MIT",
  "author": "kepano",
  "keywords": [
    "mermaid",
    "diagram",
    "diagrams",
    "flowchart",
    "svg",
    "renderer"
  ],
  "homepage": "https://pele.run",
  "bugs": "https://github.com/obsidianmd/pele/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsidianmd/pele.git"
  },
  "type": "module",
  "main": "./dist/pele.js",
  "module": "./dist/pele.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pele.js",
      "default": "./dist/pele.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/esm/core.js",
      "default": "./dist/esm/core.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/esm/lazy.js",
      "default": "./dist/esm/lazy.js"
    },
    "./diagrams/*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/esm/diagrams/*.js",
      "default": "./dist/esm/diagrams/*.js"
    },
    "./global": "./dist/pele.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/pele.js",
    "./src/index.ts"
  ],
  "engines": {
    "node": ">=20"
  }
}
